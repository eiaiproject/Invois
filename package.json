{
  "name": "invois",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Invoice & receipt maker PWA for freelancers and small businesses",
  "author": {
    "name": "Anggie Irawan",
    "url": "https://anggieirawan.my.id"
  },
  "homepage": "https://invois.pages.dev",
  "license": "MIT",
  "keywords": [
    "invoice",
    "receipt",
    "invoice-generator",
    "receipt-generator",
    "pwa",
    "offline-first",
    "indexeddb",
    "pdf",
    "freelancer-tools",
    "small-business"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p tsconfig.playwright.json --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run e2e"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
