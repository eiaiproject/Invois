{
  "name": "invois",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Invoice & receipt maker PWA for freelancers and small businesses",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p tsconfig.playwright.json --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test",
    "ci": "npm run typecheck && npm run e2e"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
